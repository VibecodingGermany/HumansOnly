# No configuration needed for local demo. Explicit modes: demo | supabase.
NEXT_PUBLIC_DATA_MODE=demo
# Required together when NEXT_PUBLIC_DATA_MODE=supabase:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put a service-role key in this app.
# Optional, server-only (never NEXT_PUBLIC_*): automatic waitlist invitation mails.
# Without these values the admin area offers "Mail schreiben" (own mail client) and "Link kopieren".
# Enter real credentials only on the server, never in the repository.
SITE_URL=https://humans-only.de
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Humans Only <noreply@vibecoding-germany.de>
SMTP_REPLY_TO=
